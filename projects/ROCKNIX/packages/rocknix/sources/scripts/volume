# Source minimal predefined functions and variables
# to ensure as much performance as possible.
. /etc/profile.d/001-functions

VOLUME=$(get_setting "audio.volume")
MAX_VOLUME=100
MIN_VOLUME=0
DEFAULT_STEP=5
STEP=${DEFAULT_STEP}
LOW_VOLUME_THRESHOLD=10
LOW_VOLUME_STEP=1

if (( ${VOLUME} >= ${MIN_VOLUME} && ${VOLUME} <= ${LOW_VOLUME_THRESHOLD} )); then
  STEP=${LOW_VOLUME_STEP}
fi

case ${1} in
  "+"|"up")
    if (( ${VOLUME} <= ${LOW_VOLUME_THRESHOLD} && ${VOLUME} + ${STEP} > ${LOW_VOLUME_THRESHOLD} )); then
      VOLUME=$(( ${LOW_VOLUME_THRESHOLD} + ${DEFAULT_STEP} ))
    else
      VOLUME=$(( ${VOLUME} + ${STEP} ))
    fi
  ;;
  "-"|"down")
    if (( ${VOLUME} > ${LOW_VOLUME_THRESHOLD} && ${VOLUME} - ${STEP} < ${LOW_VOLUME_THRESHOLD} )); then
      VOLUME=${LOW_VOLUME_THRESHOLD}
    else
      VOLUME=$(( ${VOLUME} - ${STEP} ))
    fi
  ;;
  "restore")
    true
  ;;
  *)
    VOLUME=${1}
  ;;
esac

if (( ${VOLUME} < ${MIN_VOLUME} ))
then
  VOLUME=${MIN_VOLUME}
elif (( ${VOLUME} > ${MAX_VOLUME} ))
then
  VOLUME=${MAX_VOLUME}
elif [ -z "${VOLUME}" ]
then
  VOLUME=50
fi

pactl -- set-sink-volume @DEFAULT_SINK@ ${VOLUME}%
set_setting "audio.volume" ${VOLUME}
